<?xml version="1.0" encoding="utf-8"?>
<!-- Widget file d'attente : en-tête + liste défilante des morceaux. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:padding="10dp">

    <TextView
        android:id="@+id/queue_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:textColor="#EDE9F7"
        android:textSize="14sp"
        android:paddingBottom="6dp"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="@string/widget_queue_title" />

    <ListView
        android:id="@+id/queue_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="#2A2442"
        android:dividerHeight="1dp" />

    <TextView
        android:id="@+id/queue_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textColor="#A9A2C4"
        android:textSize="13sp"
        android:padding="12dp"
        android:text="@string/widget_queue_empty" />
</LinearLayout>
