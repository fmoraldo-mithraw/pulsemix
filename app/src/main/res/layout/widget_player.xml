<?xml version="1.0" encoding="utf-8"?>
<!-- Widget lecteur : pochette, titre, artiste, transport. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@drawable/widget_bg"
    android:padding="12dp"
    android:gravity="center_vertical">

    <ImageView
        android:id="@+id/widget_art"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:background="@drawable/widget_art_bg"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_widget_note"
        android:contentDescription="@string/widget_artwork" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#B497FF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="@string/widget_nothing" />

        <TextView
            android:id="@+id/widget_artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#A9A2C4"
            android:textSize="12sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="@string/widget_tap_to_open" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/widget_prev"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="36dp"
                android:padding="6dp"
                android:src="@drawable/ic_widget_prev"
                android:contentDescription="@string/widget_prev" />

            <ImageView
                android:id="@+id/widget_toggle"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="36dp"
                android:padding="6dp"
                android:src="@drawable/ic_widget_play"
                android:contentDescription="@string/widget_play" />

            <ImageView
                android:id="@+id/widget_next"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="36dp"
                android:padding="6dp"
                android:src="@drawable/ic_widget_next"
                android:contentDescription="@string/widget_next" />

            <ImageView
                android:id="@+id/widget_open"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="36dp"
                android:padding="6dp"
                android:src="@drawable/ic_widget_open"
                android:contentDescription="@string/widget_open" />

            <!-- Lancer un enchaînement sans ouvrir l'appli -->
            <TextView
                android:id="@+id/widget_mix"
                android:layout_width="0dp"
                android:layout_weight="1.1"
                android:layout_height="36dp"
                android:gravity="center"
                android:textColor="#B497FF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:text="@string/widget_mix" />

            <TextView
                android:id="@+id/widget_dj"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="36dp"
                android:gravity="center"
                android:textColor="#8AE0C8"
                android:textSize="12sp"
                android:textStyle="bold"
                android:text="@string/widget_dj" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
